{
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/customerio/ember-provide-consume-context.git"
  },
  "license": "MIT",
  "author": "Customer.io (https://customer.io)",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm --filter ember-provide-consume-context build",
    "lint": "pnpm --recursive --if-present lint",
    "lint:fix": "pnpm --recursive --if-present lint:fix",
    "prepare": "pnpm build",
    "start": "concurrently 'pnpm start:addon' 'pnpm start:test-app' --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter ember-provide-consume-context start -- --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --recursive --if-present test",
    "test:ember": "pnpm --recursive --if-present test:ember",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "prettier": "^3.0.3",
    "prettier-plugin-ember-template-tag": "^1.1.0"
  },
  "workspaces": [
    "ember-provide-consume-context",
    "test-app"
  ],
  "dependencies": {
    "@changesets/cli": "^2.26.2"
  },
  "overrides": {
    "@glimmer/manager": "^0.84.3",
    "@glimmer/reference": "^0.84.3",
    "@glimmer/validator": "^0.84.3"
  }
}
